{
  "expo": {
    "name": "IPO Allotment",
    "slug": "ipo-allotment",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yash.ipoallotment"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.yash.ipoallotment",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "ipoallotment",
    "plugins": [
      "expo-router",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to protect your saved PANs with Face ID."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to unlock with Face ID."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.yash.ipoallotment.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.yash.ipoallotment"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "76538847-c7d9-49ab-b9ab-555d04bb6757"
      }
    },
    "owner": "yash22222"
  }
}
